# Supabase (auto-synced into Vercel by the Supabase↔Vercel integration —
# these are the actual names present in this project; do not assume
# GEMINI_API_KEY / standard names without checking `vercel env ls` first)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (lib/ai.ts only — see the comment in that file to swap to
# Claude later). This is the real key name in Vercel, not GEMINI_API_KEY.
scout_gemini_api=

# Secures /api/cron/dormant-check. Vercel automatically sends this as a
# Bearer token when it invokes the cron job (see vercel.json). Generate
# with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Applicant confirmation email (lib/email.ts). A dedicated Gmail account —
# no DNS-verified sending domain is available, so this authenticates over
# Gmail SMTP with an App Password (Google Account -> Security -> 2-Step
# Verification -> App Passwords), not the account's real password.
scout_email_user=
scout_email_password=
